 ],
 "subs": [
  {
   "t0": 0.6,
   "t1": 3.8999999999999995,
   "zh": "给你10块钱，或者给你10万块——",
   "en": "Give you ¥10, or give you ¥100,000 —",
   "shot": "S01"
  },
  {
   "t0": 4.02,
   "t1": 6.96,
   "zh": "在游戏里，你到底能买到什么？",
   "en": "what can you actually buy in a game?",
   "shot": "S01"
  },
  {
   "t0": 7.48,
   "t1": 11.320000000000002,
   "zh": "很多人觉得：二游抽卡贵，MMO是无底洞。",
   "en": "People say gacha is pricey and MMOs are bottomless pits.",
   "shot": "S02"
  },
  {
   "t0": 11.440000000000001,
   "t1": 15.640000000000002,
   "zh": "那就把8款热门游戏，放进同一张图里比一比。",
   "en": "So let's put 8 hit games on one chart.",
   "shot": "S02"
  },
  {
   "t0": 16.160000000000004,
   "t1": 20.360000000000003,
   "zh": "横轴是花的钱：从10块起步，每一格翻10倍。",
   "en": "X-axis: money spent. From ¥10, every step is ×10.",
   "shot": "S03"
  },
  {
   "t0": 20.480000000000004,
   "t1": 24.860000000000003,
   "zh": "这叫对数坐标：10、100、1000、1万、10万。",
   "en": "That's a log scale: 10, 100, 1K, 10K, 100K.",
   "shot": "S03"
  },
  {
   "t0": 26.580000000000005,
   "t1": 29.340000000000003,
   "zh": "纵轴是你换来的真实体验。",
   "en": "Y-axis: the experience you actually get.",
   "shot": "S04"
  },
  {
   "t0": 29.460000000000004,
   "t1": 33.480000000000004,
   "zh": "底部红线叫\"氪了白氪\"，顶部金线叫\"彻底氪穿\"。",
   "en": "Red floor: \"money wasted\". Gold ceiling: \"maxed out\".",
   "shot": "S04"
  },
  {
   "t0": 34.6,
   "t1": 37.540000000000006,
   "zh": "8款游戏，两两分组，四场对决。",
   "en": "8 games. 4 head-to-head matchups.",
   "shot": "S05"
  },
  {
   "t0": 37.660000000000004,
   "t1": 41.50000000000001,
   "zh": "每条曲线背后，都是一套精心设计的数学。",
   "en": "Behind every curve is carefully designed math.",
   "shot": "S05"
  },
  {
   "t0": 43.02,
   "t1": 46.86000000000001,
   "zh": "第一组：同为抽卡二游的《原神》和《恋与深空》。",
   "en": "Round 1: Genshin Impact vs Love and Deepspace.",
   "shot": "S06"
  },
  {
   "t0": 47.78,
   "t1": 51.260000000000005,
   "zh": "在10块钱档位，两条线都贴着红线。",
   "en": "At ¥10, both curves hug the red floor.",
   "shot": "S07"
  },
  {
   "t0": 51.38,
   "t1": 57.02,
   "zh": "原神1抽160原石≈16元，恋与深空1抽150钻≈15元。",
   "en": "One Genshin pull ≈ ¥16. One Deepspace pull ≈ ¥15.",
   "shot": "S07"
  },
  {
   "t0": 57.14,
   "t1": 60.260000000000005,
   "zh": "10块钱，连一发单抽都凑不齐。",
   "en": "¥10 can't even buy a single pull.",
   "shot": "S07"
  },
  {
   "t0": 60.78,
   "t1": 64.8,
   "zh": "到了100块：30元月卡 + 68元通行证，",
   "en": "At ¥100: a ¥30 monthly pass + a ¥68 battle pass —",
   "shot": "S08"
  },
  {
   "t0": 64.92,
   "t1": 67.32,
   "zh": "两条曲线第一次猛冲。",
   "en": "both curves make their first big jump.",
   "shot": "S08"
  },
  {
   "t0": 67.84,
   "t1": 71.14,
   "zh": "但月卡的本质，是一笔\"时间赎买税\"。",
   "en": "But the monthly pass is really a \"time tax\".",
   "shot": "S09"
  },
  {
   "t0": 71.26,
   "t1": 75.64,
   "zh": "一天不上线就少拿90原石——它买的是你的日活。",
   "en": "Miss a day, lose 90 Primogems. It's buying your daily logins.",
   "shot": "S09"
  },
  {
   "t0": 76.16000000000001,
   "t1": 79.10000000000001,
   "zh": "真正的分水岭，在1000块。",
   "en": "The real turning point: ¥1,000.",
   "shot": "S10"
  },
  {
   "t0": 79.22000000000001,
   "t1": 83.24000000000001,
   "zh": "二游有\"保底\"：90抽小保底，180抽大保底。",
   "en": "Gacha has pity: 90 pulls soft, 180 pulls guaranteed.",
   "shot": "S10"
  },
  {
   "t0": 83.36000000000001,
   "t1": 88.46000000000001,
   "zh": "1000块左右拿下0命新角色，已拿走80%核心体验。",
   "en": "~¥1,000 lands a new C0 character: 80% of the core experience.",
   "shot": "S10"
  },
  {
   "t0": 89.78000000000002,
   "t1": 93.44000000000001,
   "zh": "再砸到1万块抽满6命，花费涨了十倍，",
   "en": "Spend ¥10,000 for C6 — ten times the cost —",
   "shot": "S11"
  },
  {
   "t0": 93.56000000000002,
   "t1": 97.22000000000001,
   "zh": "换来的只是怪活不过三秒的数值溢出。",
   "en": "and all you get is overkill: bosses melt in 3 seconds.",
   "shot": "S11"
  },
  {
   "t0": 97.74000000000002,
   "t1": 101.58000000000001,
   "zh": "《原神》有近百个角色，卖的是\"横向配队积木\"；",
   "en": "Genshin sells ~100 characters as team-building blocks;",
   "shot": "S12"
  },
  {
   "t0": 101.70000000000002,
   "t1": 106.08000000000001,
